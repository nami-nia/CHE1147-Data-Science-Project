# Normalize text files across Windows, macOS, and Linux.
* text=auto eol=lf

# Keep notebook JSON and generated tables as text for Git diffs.
*.ipynb text eol=lf
*.csv text eol=lf

# Keep generated figures binary.
*.png binary

# Store model caches in Git LFS, including both current and legacy paths.
*.joblib filter=lfs diff=lfs merge=lfs -text
